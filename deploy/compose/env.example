# The settings of a single-host install. Secrets are not here: they are files
# under ./secrets (see init-secrets.sh). Every variable is documented in
# docs/self-managed/configuration.md.

# --- Required -------------------------------------------------------------
# The address people and agents reach this install at: an https origin, no path.
# Tokens, OAuth discovery, evidence-pack links and email links are built from it.
STACK_API_BASE_URL=https://stack.example.com

# --- Which version -------------------------------------------------------
STACK_ENGINE_VERSION=0.1.0
# STACK_ENGINE_API_IMAGE=ghcr.io/getstack-run/stack-engine-api
# STACK_ENGINE_WORKER_IMAGE=ghcr.io/getstack-run/stack-engine-worker
# STACK_ENGINE_MCP_IMAGE=ghcr.io/getstack-run/stack-engine-mcp
# The S3-compatible archive. Replace with a managed one by setting the
# AUDIT_ARCHIVE_* settings below and deleting the archive and archive-bucket services.
# ARCHIVE_IMAGE=chrislusf/seaweedfs:4.48

# --- Where it listens ----------------------------------------------------
# 127.0.0.1 keeps the ports private to this host: put your TLS proxy in front.
STACK_BIND=127.0.0.1

# --- Optional: names ------------------------------------------------------
# A separate origin for the MCP server (default: the API's origin, with /mcp
# routed to port 3001 by your proxy).
# STACK_MCP_BASE_URL=
# Where people approve things, if you run a console of your own.
# DASHBOARD_URL=
# The `iss` of the tokens this install signs. Default: the host of STACK_API_BASE_URL.
# Changing it after tokens exist invalidates them.
# STACK_ISSUER=
# An address or link that emails about an account change give for "if this was not
# you". Default: none, and those emails send the person to your administrator.
# STACK_SECURITY_CONTACT=

# --- Optional: the archive ------------------------------------------------
# AUDIT_ARCHIVE_BUCKET=stack-audit
# AUDIT_ARCHIVE_ENDPOINT=http://archive:8333
# AUDIT_ARCHIVE_REGION=us-east-1

# --- Optional: email ------------------------------------------------------
# none (default), smtp or resend. With none, nothing sends mail.
# STACK_EMAIL_TRANSPORT=smtp
# SMTP_URL=smtps://user:password@mail.example.com:465
# EMAIL_FROM=STACK <stack@example.com>

# --- Optional: the enterprise features -----------------------------------
# The licence key: see docs/self-managed/licence.md.
# STACK_LICENCE_KEY=
# Security-monitoring connector (a licensed feature).
# STACK_SIEM_SYSLOG_URL=tls://siem.example.com:6514
# STACK_SIEM_HTTP_URL=https://collector.example.com/ingest
# STACK_SIEM_STREAMS=security,audit

# --- Optional: STACK's network (client only; off unless set) -------------
# Live detection rules, and the hosted L3 classifier (which sends content to STACK).
# STACK_NETWORK_URL=https://api.getstack.run
# STACK_NETWORK_KEY=
# STACK_NETWORK_RULES=true
# STACK_NETWORK_CLASSIFIER=false

# --- Optional: a model of your own that grades intent deviation ----------
# An OpenAI-compatible chat completions endpoint; URL and name together. The key is optional.
# STACK_INTENT_MODEL_URL=https://api.openai.com/v1
# STACK_INTENT_MODEL_NAME=
# STACK_INTENT_MODEL_KEY=

# --- Optional: sign-in with OAuth ----------------------------------------
# Needs a consent page: see docs/self-managed/operations.md.
# OAUTH_ENABLED=false
