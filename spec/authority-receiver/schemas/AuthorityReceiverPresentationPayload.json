{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:authority-receiver:1:AuthorityReceiverPresentationPayload",
  "title": "AuthorityReceiverPresentationPayload",
  "type": "object",
  "properties": {
