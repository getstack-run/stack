    "exp": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "authority_use_id": {
      "type": "string",
      "pattern": "^aus_[\\w-]+$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^(ag|agt)_[\\w-]+$"
    },
    "agent_key_thumbprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "binding_ref": {
      "type": "object",
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^abn_[\\w-]+$"
