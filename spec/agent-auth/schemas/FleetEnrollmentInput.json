{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:agent-auth:1:FleetEnrollmentInput",
  "title": "FleetEnrollmentInput",
  "type": "object",
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "public_key": {
      "type": "object",
      "properties": {
        "kty": {
          "type": "string",
          "const": "OKP"
        },
        "crv": {
          "type": "string",
          "const": "Ed25519"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "kty",
        "crv",
        "x"
      ],
      "additionalProperties": false
    },
    "challenge_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "proof": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "previous_key_proof": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": [
    "idempotency_key",
    "name",
    "public_key",
    "challenge_id",
    "proof"
  ],
  "additionalProperties": false
}
