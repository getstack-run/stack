{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:record:1:EvidencePackManifest",
  "title": "EvidencePackManifest",
  "type": "object",
  "properties": {
    "pack_version": {
      "type": "number",
      "const": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "co_signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signer_kid": {
            "type": "string",
            "minLength": 1
          },
          "signer_role": {
            "type": "string",
            "enum": [
              "operator_attestation",
              "agent_self",
              "witness"
            ]
          },
          "cose_sign1": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "signer_kid",
          "signer_role",
          "cose_sign1"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^pc_[\\w-]+$"
          },
          "claim_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "envelope_cose": {
            "type": "string",
            "minLength": 1
          },
          "revoked_at_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "claim_hash",
          "envelope_cose",
          "revoked_at_ms"
        ],
        "additionalProperties": false
      }
    },
    "audit_chain_proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "audit_position": {
            "type": "integer",
            "minimum": 0
          },
          "merkle_path": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "required": [
          "claim_hash",
          "audit_position",
          "merkle_path"
        ],
        "additionalProperties": false
      }
    },
    "verification_material": {
      "type": "object",
      "properties": {
        "operator_jwks_url": {
          "type": "string",
          "format": "uri"
        },
        "operator_jwks_inline": {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "keys"
          ],
          "additionalProperties": false
        },
        "stack_system_jwks_url": {
          "type": "string",
          "format": "uri"
        },
        "stack_system_jwks_inline": {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "keys"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "operator_jwks_url",
        "operator_jwks_inline",
        "stack_system_jwks_url",
        "stack_system_jwks_inline"
      ],
      "additionalProperties": false
    },
    "schemas_inline": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "$schema": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "json_schema": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "$schema",
          "content_hash",
          "json_schema"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "pack_version",
    "claim",
    "claims",
    "audit_chain_proofs",
    "verification_material",
    "schemas_inline"
  ],
  "additionalProperties": false
}
