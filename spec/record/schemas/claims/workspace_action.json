{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "content_hash": "sha256:8917ec47a80bf2cdea19b9605583bcffc609a0ac256492bc0775948967fa110c",
  "json_schema": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "const": "workspace_action"
      },
      "action": {
        "type": "string",
        "enum": [
          "exec",
          "read_file",
          "write_file",
          "save_file",
          "stop"
        ]
      },
      "workspace_id": {
        "type": "string",
        "pattern": "^wsp_[\\w-]+$"
      },
      "account_id": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "succeeded",
          "failed",
          "timed_out"
        ]
      },
      "command_hash": {
        "type": "string"
      },
      "command_preview": {
        "type": "string",
        "maxLength": 260
      },
      "stack_access": {
        "type": "boolean"
      },
      "path": {
        "type": "string",
        "maxLength": 320
      },
      "content_hash": {
        "type": "string"
      },
      "exit_code": {
        "type": "integer"
      },
      "deleted": {
        "type": "boolean"
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0
      },
      "error_code": {
        "type": "string"
      },
      "at": {
        "type": "integer"
      },
      "mission_ref": {
        "type": "string",
        "pattern": "^ms_[\\w-]+$"
      }
    },
    "required": [
      "type",
      "action",
      "workspace_id",
      "account_id",
      "status",
      "duration_ms",
      "at",
      "mission_ref"
    ],
    "additionalProperties": false
  }
}
