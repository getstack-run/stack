{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "content_hash": "sha256:f6aa07dae9e1b5ef6d1558286645ffdee5a96ed6403999a564a0a9ad516ff09a",
  "json_schema": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "const": "checkpoint_approval"
      },
      "checkpoint_id": {
        "type": "string",
        "pattern": "^chk_[\\w-]+$"
      },
      "interval_seconds": {
        "anyOf": [
          {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "services_used": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "actions_count": {
        "type": "integer",
        "minimum": 0
      },
      "has_summary": {
        "type": "boolean",
        "default": false
      },
      "delegated_to": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "submitted_by": {
        "type": "string"
      },
      "submitted_at": {
        "type": "integer"
      },
      "mission_ref": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^ms_[\\w-]+$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "type",
      "checkpoint_id",
      "interval_seconds",
      "actions_count",
      "submitted_by",
      "submitted_at"
    ],
    "additionalProperties": false
  }
}
