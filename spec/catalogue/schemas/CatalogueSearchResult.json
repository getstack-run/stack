{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:catalogue:1:CatalogueSearchResult",
  "title": "CatalogueSearchResult",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 330,
            "pattern": "^(?:model|tool|service|skill|account|mcp_tool):[A-Za-z0-9~][A-Za-z0-9._~:@/+-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "model",
              "tool",
              "service",
              "skill",
              "account",
              "mcp_tool"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "stack",
              "models",
              "tools",
              "publisher"
            ]
          },
          "provider": {
            "type": "string",
            "maxLength": 64
          },
          "modalities": {
            "type": "object",
            "properties": {
              "input": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 32
                },
                "maxItems": 8
              },
              "output": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 32
                },
                "maxItems": 8
              }
            },
            "required": [
              "input",
              "output"
            ],
            "additionalProperties": false
          },
          "context_length": {
            "type": "integer",
            "minimum": 1
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "input_schema": {
            "type": "object",
            "additionalProperties": {}
          },
          "price": {
            "type": "object",
            "properties": {
              "unit": {
                "type": "string",
                "enum": [
                  "token",
                  "call",
                  "result",
                  "image",
                  "lines",
                  "free",
                  "varies"
                ]
              },
              "currency": {
                "type": "string",
                "const": "USD"
              },
              "provider_cost": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "per_unit_usd_micros": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "flat_fee_usd_micros": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "input_per_million_tokens_usd_micros": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "output_per_million_tokens_usd_micros": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "worst_case_usd_micros": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "lines": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "item": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_]{0,63}$"
                            },
                            "per": {
                              "type": "string",
                              "enum": [
                                "token",
                                "character",
                                "second",
                                "request",
                                "image",
                                "search",
                                "megapixel_second",
                                "generation",
                                "audio_unit",
                                "minute",
                                "hour",
                                "month",
                                "message",
                                "segment",
                                "gigabyte",
                                "gigabyte_month"
                              ]
                            },
                            "per_count": {
                              "type": "number",
                              "enum": [
                                1,
                                1000000
                              ]
                            },
                            "cost_usd_micros": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "item",
                            "per",
                            "per_count",
                            "cost_usd_micros"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      },
                      "tiers": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "above_prompt_tokens": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "lines": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "item": {
                                    "type": "string",
                                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                  },
                                  "per": {
                                    "type": "string",
                                    "enum": [
                                      "token",
                                      "character",
                                      "second",
                                      "request",
                                      "image",
                                      "search",
                                      "megapixel_second",
                                      "generation",
                                      "audio_unit",
                                      "minute",
                                      "hour",
                                      "month",
                                      "message",
                                      "segment",
                                      "gigabyte",
                                      "gigabyte_month"
                                    ]
                                  },
                                  "per_count": {
                                    "type": "number",
                                    "enum": [
                                      1,
                                      1000000
                                    ]
                                  },
                                  "cost_usd_micros": {
                                    "type": "integer",
                                    "minimum": 0
                                  }
                                },
                                "required": [
                                  "item",
                                  "per",
                                  "per_count",
                                  "cost_usd_micros"
                                ],
                                "additionalProperties": false
                              },
                              "minItems": 1
                            }
                          },
                          "required": [
                            "lines"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1,
                        "maxItems": 16
                      },
                      "discount": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "free_per_month": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "item": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    },
                    "per": {
                      "type": "string",
                      "enum": [
                        "token",
                        "character",
                        "second",
                        "request",
                        "image",
                        "search",
                        "megapixel_second",
                        "generation",
                        "audio_unit",
                        "minute",
                        "hour",
                        "month",
                        "message",
                        "segment",
                        "gigabyte",
                        "gigabyte_month"
                      ]
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "item",
                    "per",
                    "count"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 8
              },
              "stack_actions": {
                "type": "number",
                "enum": [
                  0,
                  1
                ]
              }
            },
            "required": [
              "unit",
              "currency",
              "provider_cost",
              "stack_actions"
            ],
            "additionalProperties": false
          },
          "result_trust": {
            "type": "string",
            "enum": [
              "standard",
              "untrusted"
            ]
          },
          "run": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 4,
                "maxLength": 200,
                "pattern": "^\\/v1\\/[A-Za-z0-9._~\\-/{}:]+$"
              },
              "body": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 300
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "mcp_tool": {
                "type": "string",
                "pattern": "^stack_[a-z0-9_]+$",
                "maxLength": 80
              },
              "cost_cap": {
                "type": "object",
                "properties": {
                  "in": {
                    "type": "string",
                    "enum": [
                      "body",
                      "header"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  }
                },
                "required": [
                  "in",
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "method",
              "path"
            ],
            "additionalProperties": false
          },
          "tool": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "pieces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "maxItems": 8
              },
              "audience": {
                "type": "string",
                "enum": [
                  "agent",
                  "owner",
                  "both"
                ]
              },
              "on_demand": {
                "type": "boolean"
              }
            },
            "required": [
              "group",
              "pieces",
              "audience",
              "on_demand"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "description",
          "origin",
          "price",
          "result_trust"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "total",
    "entries"
  ],
  "additionalProperties": false
}
