{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:network:1:AddInstallKeyInput",
  "title": "AddInstallKeyInput",
  "type": "object",
  "properties": {
    "public_jwk": {
      "type": "object",
      "properties": {
        "kty": {
          "type": "string",
          "const": "OKP"
        },
        "crv": {
          "type": "string",
          "const": "Ed25519"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "kty",
        "crv",
        "x"
      ],
      "additionalProperties": false
    },
    "proof": {
      "type": "string",
      "minLength": 20,
      "maxLength": 24000,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "rollover_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    }
  },
  "required": [
    "public_jwk",
    "proof"
  ],
  "additionalProperties": false
}
