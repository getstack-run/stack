  "properties": {
    "kty": {
      "type": "string",
      "const": "OKP"
    },
    "crv": {
      "type": "string",
      "const": "Ed25519"
    },
    "x": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "kty",
    "crv",
    "x"
  ],
  "additionalProperties": false
}
