{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:credentials-files:1:StoredOperatorCredentials",
  "title": "StoredOperatorCredentials",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "refresh_token": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "refresh_expires_at": {
      "type": "integer",
      "minimum": 0
    },
    "operator_email": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "refresh_token",
    "issued_at",
    "refresh_expires_at",
    "scope"
  ],
  "additionalProperties": true
}
