{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:partner:1:PartnerReleaseRecord",
  "title": "PartnerReleaseRecord",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "external_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "returned",
        "cancelled"
      ]
    },
    "requested_by": {
      "type": "string",
      "enum": [
        "partner",
        "customer"
      ]
    },
    "requested_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "account_id",
    "external_ref",
    "status",
    "requested_by",
    "requested_at",
    "expires_at",
    "completed_at"
  ],
  "additionalProperties": false
}
