{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:partner:1:PartnerAccountView",
  "title": "PartnerAccountView",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "external_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "billing": {
      "type": "string",
      "const": "partner"
    },
    "status": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "deleted_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "invite": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "invited",
            "active"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "period": {
          "type": "string"
        },
        "actions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "period",
        "actions"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "monthly_cents": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "paused"
          ]
        },
        "renews_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "controls": {
          "type": "object",
          "properties": {
            "monthly_cents": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "status": {
              "type": "string",
              "enum": [
                "off",
                "active",
                "paused"
              ]
            },
            "renews_on": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "monthly_cents",
            "status",
            "renews_on"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "monthly_cents",
        "status",
        "renews_on",
        "controls"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "account_id",
    "external_ref",
    "billing",
    "status",
    "created_at",
    "deleted_at",
    "invite"
  ],
  "additionalProperties": false
}
