{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:agent-keys:1:AgentJwk",
  "title": "AgentJwk",
  "type": "object",
  "properties": {
    "kty": {
      "type": "string",
      "const": "OKP"
    },
    "crv": {
      "type": "string",
      "const": "Ed25519"
    },
    "x": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "kid": {
      "type": "string",
      "pattern": "^agent:[^:]+:v[1-9][0-9]*$"
    },
    "alg": {
      "type": "string",
      "const": "EdDSA"
    },
    "use": {
      "type": "string",
      "const": "sig"
    },
    "not_before": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "not_after": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kty",
    "crv",
    "x",
    "kid",
    "alg",
    "use",
    "not_before",
    "not_after"
  ],
  "additionalProperties": false
}
