{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:control-socket:1:ControlDecisionAnswer",
  "title": "ControlDecisionAnswer",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "request_digest": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    },
    "reason": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "message": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "after_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "policy_ref": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "decision_id",
    "request_digest",
    "verdict"
  ],
  "additionalProperties": false
}
