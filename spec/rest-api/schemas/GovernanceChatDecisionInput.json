{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:rest-api:1:GovernanceChatDecisionInput",
  "title": "GovernanceChatDecisionInput",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mcp_session_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "elicitation_id": {
      "type": "string",
      "format": "uuid"
    },
    "issued_at": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "attestation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "decision"
  ],
  "additionalProperties": false
}
