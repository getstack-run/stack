            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "platform_intent": {
          "type": "string",
          "enum": [
            "staff",
            "monitor"
          ]
        }
      },
      "required": [
        "summary",
        "services"
      ],
      "additionalProperties": false
    },
    "checkpoint_interval_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    },
    "mission_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ms_[\\w-]+$"
      }
    },
    "authority_binding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^abn_[\\w-]+$"
      },
      "maxItems": 8
    }
  },
  "required": [
    "agent_id"
  ],
  "additionalProperties": false
}
