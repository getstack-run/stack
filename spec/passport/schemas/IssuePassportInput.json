            "type": "string"
          }
        },
        "will_delegate": {
          "type": "boolean"
        },
        "estimated_duration_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "params": {
                "type": "object",
                "additionalProperties": {},
                "default": {}
              }
