{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:oauth-profile:1:OAuthServerMetadata",
  "title": "OAuthServerMetadata",
  "type": "object",
  "properties": {
    "issuer": {
      "type": "string",
      "format": "uri"
    },
    "authorization_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "token_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "device_authorization_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "registration_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "revocation_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "jwks_uri": {
      "type": "string",
      "format": "uri"
    },
    "response_types_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "const": "code"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "grant_types_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "code_challenge_methods_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "const": "S256"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "token_endpoint_auth_methods_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "const": "none"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "client_id_metadata_document_supported": {
      "type": "boolean",
      "const": true
    },
    "scopes_supported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "service_documentation": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "issuer",
    "authorization_endpoint",
    "token_endpoint",
    "device_authorization_endpoint",
    "registration_endpoint",
    "revocation_endpoint",
    "jwks_uri",
    "response_types_supported",
    "grant_types_supported",
    "code_challenge_methods_supported",
    "token_endpoint_auth_methods_supported",
    "client_id_metadata_document_supported",
    "scopes_supported",
    "service_documentation"
  ],
  "additionalProperties": false
}
