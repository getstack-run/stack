{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stack:spec:workload-identity:1:WorkloadSvidPassportResult",
  "title": "WorkloadSvidPassportResult",
  "type": "object",
  "properties": {
    "passport": {
      "type": "string",
      "minLength": 1
    },
    "jti": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "spiffe_id": {
      "type": "string",
      "pattern": "^spiffe:\\/\\/[^/]+(\\/.*)?$"
    },
    "trust_domain": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "ttl_seconds": {
      "type": "integer",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "passport",
    "jti",
    "expires_at",
    "spiffe_id",
    "trust_domain",
    "claim_id",
    "ttl_seconds"
  ],
  "additionalProperties": false
}
