{
  "name": "@stack/api",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc",
    "dev": "STACK_DEPLOYMENT=self_managed tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@sentry/node": "^10.75.3",
    "@stack/dropoff": "workspace:*",
    "@stack/shared": "workspace:*",
    "@stack/vault": "workspace:*",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.6",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "postgres": "^3.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  }
}
