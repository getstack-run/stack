{
  "name": "@getstackrun/cli",
  "version": "2.6.0",
  "description": "STACK from your terminal. Issue passports, register agents, grant credentials, revoke in one call, and tail the live audit log. The operator CLI for every STACK surface.",
  "type": "module",
  "bin": {
    "stack-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "stack",
    "agents",
    "ai-agents",
    "mcp",
    "audit",
    "monitoring",
    "cli"
  ],
  "homepage": "https://getstack.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getstack-run/stack.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@getstackrun/sdk": "workspace:^",
    "cbor-x": "^1.6.4"
  },
  "devDependencies": {
    "@stack/shared": "workspace:*",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  }
}
