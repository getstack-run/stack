{
  "name": "@stack/vault",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc && node ../../tooling/build-stamp.mjs",
    "dev": "tsc --watch",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1019.0",
    "@stack/shared": "workspace:*",
    "ajv": "^8.18.0",
    "cbor-x": "^1.6.4",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "nodemailer": "10.1.4"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  }
}
